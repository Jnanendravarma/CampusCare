{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "noEmit": true,
    /* JSX Support for .jsx files */
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    /* Linting */
    "strict": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "frontend/src"
  ]
}